{
  "name": "@yiong/railguard",
  "version": "0.6.0",
  "description": "Lifecycle-hook guardrail pipeline for LLM apps and agents: data-access guards and LLM I/O guards in one zero-dependency TypeScript library. In-process, Node + edge, per-rule enforce/observe/off.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rules": {
      "types": "./dist/rules/index.d.ts",
      "default": "./dist/rules/index.js"
    },
    "./audit": {
      "types": "./dist/audit/index.d.ts",
      "default": "./dist/audit/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "default": "./dist/data/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./eval": {
      "types": "./dist/eval/index.d.ts",
      "default": "./dist/eval/index.js"
    },
    "./adapters/vercel-ai": {
      "types": "./dist/adapters/vercel-ai.d.ts",
      "default": "./dist/adapters/vercel-ai.js"
    },
    "./adapters/mastra": {
      "types": "./dist/adapters/mastra.d.ts",
      "default": "./dist/adapters/mastra.js"
    },
    "./otel": {
      "types": "./dist/otel/index.d.ts",
      "default": "./dist/otel/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:zero-deps": "node -e \"const p=require('./package.json');if(Object.keys(p.dependencies||{}).length){console.error('dependencies must stay empty');process.exit(1)}\"",
    "check:no-node-imports": "node scripts/check-runtime-purity.mjs",
    "gen:coverage": "pnpm build && node scripts/gen-coverage.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "pnpm gen:coverage && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check:package": "publint && node scripts/check-package-shape.mjs",
    "check": "pnpm check:zero-deps && pnpm check:no-node-imports && pnpm typecheck && pnpm test",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "prepublishOnly": "pnpm check && pnpm build && pnpm check:package"
  },
  "keywords": [
    "llm",
    "guardrails",
    "llm-guardrails",
    "prompt-injection",
    "agent-security",
    "hallucination",
    "citation",
    "rbac",
    "ai-safety",
    "vercel-ai-sdk",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yiongq/railguard.git"
  },
  "homepage": "https://yiongq.github.io/railguard/",
  "bugs": {
    "url": "https://github.com/yiongq/railguard/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.10.0",
    "publint": "^0.3.24",
    "tsdown": "0.15.7",
    "typescript": "^5.7.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@10.30.2"
}
